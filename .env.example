# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Per-agent model IDs (overridable). Defaults are the latest Claude 4.X family.
MODEL_ORCHESTRATOR=claude-opus-4-6
MODEL_RESEARCH=claude-sonnet-4-6
MODEL_SCREENER=claude-haiku-4-5-20251001
MODEL_CONSTRUCTOR=claude-opus-4-6
MODEL_SCENARIOS=claude-sonnet-4-6

# --- Alpaca paper ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Cost caps (USD) ---
PER_RUN_COST_CAP_USD=2.00
DAILY_COST_CAP_USD=10.00

# --- Live trading gate (do not enable; see CLAUDE.md §Promotion to live) ---
LIVE_TRADING_ENABLED=false
