# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Per-agent model IDs (overridable). Defaults are the latest Claude 4.X family.
# v2 pipeline has 2 LLM-bearing stages (strategist + constructor) + the meta
# scheduling call. v1's MODEL_RESEARCH / MODEL_SCREENER / MODEL_SCENARIOS are
# no longer read — delete them from your live .env if present.
MODEL_STRATEGIST=claude-sonnet-4-6
MODEL_CONSTRUCTOR=claude-opus-4-7
MODEL_CRITIC=claude-sonnet-4-6
MODEL_ORCHESTRATOR=claude-sonnet-4-6

# --- Alpaca paper ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Virtual NAV override ---
# Alpaca paper accounts start at $100k. The CLAUDE.md spec sizes for a £2k
# (~$2,500) experimental account, so the agent NEVER sizes against broker
# equity. This var pins the synthetic NAV baseline; realized P&L from
# trades.jsonl is layered on top. If unset or malformed, the code falls back
# to a hard-coded $2,500 baseline (NOT broker equity — Phase 3 deliberately
# removed the broker-equity path so a missing var can't size ~40x too large).
# See CLAUDE.md §"Paper → live code change map" item 3.
VIRTUAL_NAV_USD=2500

# --- Cost caps (USD) ---
PER_RUN_COST_CAP_USD=3.00
DAILY_COST_CAP_USD=12.00

# --- Order submission gate (Phase 10c) ---
# Default OFF. Set to true to let stage_execute actually submit paper orders
# via Alpaca to converge actual positions on the target portfolio. Until
# then, the orchestrator writes portfolio.json + decision_log but does not
# touch the broker. Safe to flip on once you've validated decisions a few
# times manually.
ORDERS_ENABLED=false

# --- Modelled trading costs (paper friction honesty) ---
# Alpaca paper reports $0 fees and models no slippage, so raw paper P&L is
# GROSS and overstates a live Alpaca account. With this ON (default), each
# synced fill is stamped with modelled regulatory fees (sell-side; paper only)
# and per-side slippage from lib/alpaca_costs.py, so realized P&L, the equity
# curve, Sharpe and the SPY benchmark are all NET of cost. Set to false to
# record raw gross fills instead. See CLAUDE.md §Promotion to live.
PAPER_COST_MODEL=true
# Default per-side slippage (bps of notional); thin tickers have wider
# per-ticker overrides in lib/alpaca_costs.py (SLIPPAGE_OVERRIDES).
SLIPPAGE_BPS_PER_SIDE=2.0
# Regulatory rates change periodically — override here, don't edit code.
# SEC §31 resets to $0 when its appropriation is hit; FINRA TAF updates each
# January; CAT is currently suspended ($0) but can resume.
# ALPACA_SEC_FEE_PER_DOLLAR=0.0000206   # sells only
# ALPACA_TAF_PER_SHARE=0.000195         # sells only
# ALPACA_TAF_CAP_PER_TRADE=9.79
# ALPACA_CAT_PER_SHARE=0.00             # suspended; per share, buys+sells

# --- Post-construct sanity gating ---
# lib/sanity.py runs deterministic rules after stage_construct on every
# cycle (zero LLM cost). Default OFF: rules emit sanity.json and surface
# in the dashboard but do NOT block stage_execute. Set to true to escalate
# any rule with status=fail into a hard skip of stage_execute (portfolio +
# sanity + next_run still written so the operator can see what was
# rejected and why). See lib/sanity.py for the rule list.
SANITY_BLOCK_ON_FAIL=false

# --- Live trading gate (do not enable; see CLAUDE.md §Promotion to live) ---
# The live broker is Alpaca itself (Alpaca live is available to UK retail for
# ETFs) — NO separate broker client (e.g. IBKR) is needed. When the promotion
# criteria are met, going live is: (1) set ALPACA_BASE_URL=https://api.alpaca.markets
# with live USD-funded ALPACA_API_KEY/SECRET, (2) set LIVE_TRADING_ENABLED=true,
# (3) bump LIVE_VERSION 0->1 in lib/live_gate.py (code change, not env).
LIVE_TRADING_ENABLED=false

# Optional live-mode sizing allocation. When the broker is genuinely live
# and this is set, the agent sizes against the capped starting allocation
# min(starting equity, cap) plus live P&L since the transition (never more
# than real equity) — set this if you fund the account with more than you
# want the agent to risk. Losses debit the allocation immediately (a $5k
# account capped at $2.5k that loses $1k sizes the next cycle at $1.5k);
# profits compound it, like the paper synthetic balance. Unset or blank =
# size against full equity. FAIL-CLOSED semantics: a malformed/non-positive
# value, or an allocation debited to $0, skips the cycle entirely (no
# orders, no LLM calls) rather than silently sizing against the deposit.
# Deposits/withdrawals after the transition shift the P&L delta — re-anchor
# by clearing state/live_transition.json after re-funding. Ignored on paper.
# LIVE_NAV_CAP_USD=2500
