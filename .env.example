# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Per-agent model IDs (overridable). Defaults are the latest Claude 4.X family.
MODEL_ORCHESTRATOR=claude-sonnet-4-6
MODEL_RESEARCH=claude-sonnet-4-6
MODEL_SCREENER=claude-haiku-4-5-20251001
MODEL_CONSTRUCTOR=claude-sonnet-4-6
MODEL_SCENARIOS=claude-sonnet-4-6

# --- Alpaca paper ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Virtual NAV override ---
# Alpaca paper accounts start at $100k. The CLAUDE.md spec sizes for a £2k
# (~$2,500) experimental account. Set this to pin the agent to that smaller
# notional regardless of broker-reported equity. Unset to use broker equity.
VIRTUAL_NAV_USD=2500

# --- Cost caps (USD) ---
PER_RUN_COST_CAP_USD=3.00
DAILY_COST_CAP_USD=12.00

# --- Order submission gate (Phase 10c) ---
# Default OFF. Set to true to let stage_execute actually submit paper orders
# via Alpaca to converge actual positions on the target portfolio. Until
# then, the orchestrator writes portfolio.json + decision_log but does not
# touch the broker. Safe to flip on once you've validated decisions a few
# times manually.
ORDERS_ENABLED=false

# --- Live trading gate (do not enable; see CLAUDE.md §Promotion to live) ---
LIVE_TRADING_ENABLED=false
