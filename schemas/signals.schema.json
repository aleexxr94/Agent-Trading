{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trading.local/schemas/signals.schema.json",
  "title": "Signals",
  "description": "Output of v2 pipeline stage 1 (signals). Deterministic per-ticker feature table built from market_data. Zero LLM cost. Replaces the v1 screen + research + scenarios stages.",
  "type": "object",
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "tickers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$"},
          "kind": {"enum": ["etf", "unknown"]},
          "factor": {"type": "string"},
          "leverage_factor": {"type": "number"},
          "family": {"type": "string"},
          "last_close": {"type": ["number", "null"]},
          "adv_30d": {"type": ["integer", "null"]},
          "momentum_30d_pct": {"type": ["number", "null"]},
          "momentum_60d_pct": {"type": ["number", "null"]},
          "hv_30d_annualised": {"type": ["number", "null"]},
          "hv_90d_annualised": {"type": ["number", "null"]},
          "dist_from_50d_ma_pct": {"type": ["number", "null"]},
          "dist_from_200d_ma_pct": {"type": ["number", "null"]},
          "rsi_14": {"type": ["number", "null"],
            "description": "14-day RSI (Cutler's SMA variant). >70 extended, <30 washed out."},
          "rel_strength_spy_30d": {"type": ["number", "null"],
            "description": "Ticker 30d return minus SPY 30d return (pct points). Positive = leading the tape."},
          "trend_r2": {"type": ["number", "null"],
            "description": "R² of close vs time over 60 sessions. ~1 = clean trend, ~0 = chop (leveraged-ETF decay zone)."},
          "upcoming_macro_events_7d": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {"type": "string", "format": "date"},
                "type": {"type": "string"},
                "description": {"type": "string"},
                "days_away": {"type": "integer"}
              },
              "required": ["date", "type"],
              "additionalProperties": true
            }
          },
          "error": {"type": "string"}
        },
        "required": ["symbol", "kind", "factor", "leverage_factor"],
        "additionalProperties": false
      }
    },
    "factor_correlations": {
      "type": "array",
      "description": "Pairwise 30d return correlation between factor bull ETFs (|corr| >= 0.7 only) so the LLM stages can see which factors are currently the same bet.",
      "items": {
        "type": "object",
        "properties": {
          "factor_a": {"type": "string"},
          "factor_b": {"type": "string"},
          "corr_30d": {"type": "number", "minimum": -1, "maximum": 1}
        },
        "required": ["factor_a", "factor_b", "corr_30d"],
        "additionalProperties": false
      }
    }
  },
  "required": ["run_id", "generated_at", "tickers"],
  "additionalProperties": false
}
