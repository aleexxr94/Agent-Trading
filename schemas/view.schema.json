{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trading.local/schemas/view.schema.json",
  "title": "View",
  "description": "Output of v2 pipeline stage 2 (strategist). One LLM call against the deterministic signals table; emits a regime classification + up to 6 ranked candidate ideas. The constructor stage reads this + signals.json to build the portfolio.",
  "type": "object",
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "regime": {
      "enum": [
        "risk_on", "risk_off", "neutral",
        "vol_elevated", "trending_up", "trending_down", "choppy"
      ]
    },
    "regime_rationale": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$"},
          "instrument_kind": {"enum": ["etf", "option_call", "option_put"]},
          "thesis": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["symbol", "instrument_kind", "thesis", "confidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["run_id", "generated_at", "regime", "regime_rationale", "candidates"],
  "additionalProperties": false
}
